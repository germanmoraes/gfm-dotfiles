import Quickshell
import QtQuick
import qs.services

Item {
    id: root

    implicitWidth: capsule.width
    implicitHeight: 36

    SystemMonitorService {
        id: service
    }

    component MonitorValue: Item {
        id: valueRoot

        property string icon: ""
        property string value: ""
        property string label: ""

        implicitWidth: contentRow.implicitWidth
        implicitHeight: 36

        Row {
            id: contentRow

            anchors.verticalCenter: parent.verticalCenter
            spacing: 5

            Text {
                text: valueRoot.icon

                font.family: "Material Symbols Rounded"
                font.pixelSize: 16
                font.weight: Font.Normal

                color: "#8b8b92"

                verticalAlignment: Text.AlignVCenter
                renderType: Text.NativeRendering
            }

            Column {
                spacing: -3

                Text {
                    text: valueRoot.value

                    font.family: "Inter"
                    font.pixelSize: 10
                    font.weight: Font.DemiBold

                    color: "#d8d8dc"

                    verticalAlignment: Text.AlignVCenter
                }

                Text {
                    text: valueRoot.label

                    font.family: "Inter"
                    font.pixelSize: 7
                    font.weight: Font.Normal

                    color: "#77777e"

                    verticalAlignment: Text.AlignVCenter
                }
            }
        }
    }

    Rectangle {
        id: capsule

        width: contentRow.implicitWidth + 18
        height: 36

        radius: 18
        color: "#242428"

        Row {
            id: contentRow

            anchors.centerIn: parent
            spacing: 7

            MonitorValue {
                icon: "\ue322"
                value: service.cpuUsage.toFixed(0) + "%"
                label: "CPU"
            }

            MonitorValue {
                icon: "\ue30c"
                value: service.gpuUsage.toFixed(0) + "%"
                label: "GPU"
            }

            MonitorValue {
                icon: "\ue322"
                value: service.memoryUsage.toFixed(0) + "%"
                label: "RAM"
            }

            MonitorValue {
                icon: "\ue8e5"
                value: service.downloadSpeed
                label: "↓"
            }

            MonitorValue {
                icon: "\ue8e5"
                value: service.uploadSpeed
                label: "↑"
            }
        }

        MouseArea {
            anchors.fill: parent

            cursorShape: Qt.PointingHandCursor

            onClicked: {
                // Popup detalhado será conectado aqui.
            }
        }
    }
}
