import Quickshell
import Quickshell.Services.SystemTray
import Quickshell.Widgets
import QtQuick

Rectangle {
    id: systemTray

    // ============================================================
    // CORES
    // ============================================================

    readonly property color capsuleColor:
        "#000000"

    readonly property color capsuleHoverColor:
        "#303030"

    readonly property color borderColor:
        "transparent"

    readonly property color itemHoverColor:
        "#25252a"

    // ============================================================
    // GEOMETRIA
    // ============================================================

    readonly property int capsuleHeight:
        32

    readonly property int capsuleRadius:
        16

    readonly property int horizontalPadding:
        6

    readonly property int itemSpacing:
        4

    readonly property int itemWidth:
        28

    readonly property int iconSize:
        20

    // ============================================================
    // CÁPSULA
    // ============================================================

    height:
        capsuleHeight

    width:
        Math.max(
            capsuleHeight,
            trayRow.implicitWidth +
            horizontalPadding * 2
        )

    radius:
        capsuleRadius

    color:
        capsuleColor

    border.color:
        borderColor

    // ============================================================
    // ITENS DA SYSTEM TRAY
    // ============================================================

    Row {
        id: trayRow

        anchors {
            left:
                parent.left

            right:
                parent.right

            verticalCenter:
                parent.verticalCenter

            leftMargin:
                systemTray.horizontalPadding

            rightMargin:
                systemTray.horizontalPadding
        }

        spacing:
            systemTray.itemSpacing

        Repeater {
            model:
                SystemTray.items

            delegate:
                Item {
                    required property var modelData

                    width:
                        systemTray.itemWidth

                    height:
                        systemTray.capsuleHeight

                    // ====================================================
                    // ÍCONE
                    // ====================================================

                    IconImage {
                        id: trayIcon

                        anchors.centerIn:
                            parent

                        width:
                            systemTray.iconSize

                        height:
                            systemTray.iconSize

                        source:
                            modelData.icon
                    }

                    // ====================================================
                    // FUNDO DO ITEM AO PASSAR O MOUSE
                    // ====================================================

                    Rectangle {
                        anchors.fill:
                            parent

                        radius:
                            8

                        color:
                            itemMouseArea.containsMouse
                            ? systemTray.itemHoverColor
                            : "transparent"

                        z:
                            -1
                    }

                    // ====================================================
                    // INTERAÇÃO
                    // ====================================================

                    MouseArea {
                        id: itemMouseArea

                        anchors.fill:
                            parent

                        hoverEnabled:
                            true

                        acceptedButtons:
                            Qt.LeftButton |
                            Qt.MiddleButton |
                            Qt.RightButton

                        onClicked: function(mouse) {

                            if (mouse.button === Qt.LeftButton) {

                                if (modelData.hasMenu) {
                                    modelData.display(
                                        systemTray,
                                        0,
                                        systemTray.height
                                    )
                                } else {
                                    modelData.activate()
                                }

                                return
                            }

                            if (mouse.button === Qt.MiddleButton) {
                                modelData.secondaryActivate()
                                return
                            }

                            if (mouse.button === Qt.RightButton) {

                                if (modelData.hasMenu) {
                                    modelData.display(
                                        systemTray,
                                        0,
                                        systemTray.height
                                    )
                                }
                            }
                        }

                        onWheel: function(wheel) {

                            if (wheel.angleDelta.y !== 0) {
                                modelData.scroll(
                                    wheel.angleDelta.y,
                                    false
                                )
                            }
                        }
                    }
                }
        }
    }
}
