import Quickshell
import QtQuick

Rectangle {
    id: appLauncher

    width: 50
    height: 32

    radius: 16

    color: mouseArea.containsMouse
        ? "#303030"
        : "#000000"

    Behavior on color {
        ColorAnimation {
            duration: 150
        }
    }

    Text {
        anchors.centerIn: parent

        text: "󰀻"

        color: "#00e5ff"

        font.family: "Symbols Nerd Font"
        font.pixelSize: 20
    }

    MouseArea {
        id: mouseArea

        anchors.fill: parent

        hoverEnabled: true

        onClicked: {
            Quickshell.execDetached(["hyprlauncher"])
        }
    }
}
