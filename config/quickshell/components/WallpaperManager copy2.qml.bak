import Quickshell
import Quickshell.Io
import QtQuick
import QtQuick.Controls
import QtQuick.Layouts
import Qt.labs.folderlistmodel
import Qt.labs.platform
import QtMultimedia

PopupWindow {
    id: manager

    // ============================================================
    // CONFIGURAÇÃO GERAL
    // ============================================================

    property string wallpaperDirectory:
        "/home/germano/Imagens/Wallpapers"

    property string monitorName:
        "HDMI-A-1"

    property int windowWidth:
        920

    property int windowHeight:
        680

    // ============================================================
    // CORES
    // ============================================================

    property color windowColor:
        "#e9141418"

    property color panelColor:
        "#d91b1b21"

    property color cardColor:
        "#b5222229"

    property color cardHoverColor:
        "#d52d2d36"

    property color cardSelectedColor:
        "#d63b3948"

    property color borderColor:
        "#352f3a"

    property color borderSelectedColor:
        "#6c63ff"

    property color primaryTextColor:
        "#f0eef5"

    property color secondaryTextColor:
        "#96929f"

    property color mutedTextColor:
        "#6f6b76"

    property color accentColor:
        "#8b7cff"

    property color accentTextColor:
        "#ffffff"

    // ============================================================
    // DIMENSÕES
    // ============================================================

    property int outerMargin:
        20

    property int headerHeight:
        64

    property int footerHeight:
        64

    property int gridSpacing:
        14

    property int cardWidth:
        164

    property int cardHeight:
        132

    property int cardRadius:
        12

    property int thumbnailHeight:
        94

    property int contentRadius:
        16

    // ============================================================
    // ANCORAGEM
    // ============================================================

    visible: false

    grabFocus: false

    implicitWidth: manager.windowWidth
    implicitHeight: manager.windowHeight

    color: "transparent"

    anchor.window: barWindow

    anchor.rect.x:
        (barWindow.width - manager.windowWidth) / 2

    anchor.rect.y:
        barWindow.height + 12

    property var barWindow

    // ============================================================
    // TIPOS DE MÍDIA
    // ============================================================

    function extension(path) {
        var name = path.toLowerCase()
        var dot = name.lastIndexOf(".")

        if (dot < 0)
            return ""

        return name.substring(dot + 1)
    }

    function isStatic(path) {
        var ext = extension(path)

        return [
            "jpg",
            "jpeg",
            "png",
            "webp",
            "bmp"
        ].indexOf(ext) !== -1
    }

    function isAnimated(path) {
        return !isStatic(path)
    }

    // ============================================================
    // BACKEND
    // ============================================================

    Process {
        id: wallpaperProcess

        command: []

        running: false

        stderr: SplitParser {
            onRead: function(data) {
                console.warn("Wallpaper:", data)
            }
        }
    }

    function stopWallpaperBackends() {
        wallpaperProcess.running = false
    }

    function modeForSwaybg(mode) {
        if (mode === "Preencher")
            return "fill"

        if (mode === "Ajustar")
            return "fit"

        if (mode === "Esticar")
            return "stretch"

        return "center"
    }

    function applyWallpaper(path) {
        if (!path || path === "")
            return

        selectedWallpaper = path

        wallpaperProcess.running = false

        if (isStatic(path)) {
            wallpaperProcess.exec([
                "swaybg",
                "-o",
                manager.monitorName,
                "-i",
                path,
                "-m",
                modeForSwaybg(manager.displayMode)
            ])

            return
        }

        wallpaperProcess.exec([
            "mpvpaper",
            "-l",
            "background",
            "-o",
            "--loop-file=inf",
            manager.monitorName,
            path
        ])
    }

    // ============================================================
    // MODELO DE WALLPAPERS
    // ============================================================

    FolderListModel {
        id: wallpaperModel

        folder:
            "file://" + manager.wallpaperDirectory

        showDirs:
            false

        showFiles:
            true

        nameFilters: [
            "*.jpg",
            "*.jpeg",
            "*.png",
            "*.webp",
            "*.bmp",
            "*.gif",
            "*.mp4",
            "*.mkv",
            "*.webm",
            "*.mov",
            "*.avi"
        ]

        sortField:
            FolderListModel.Name

        sortReversed:
            false
    }

    // ============================================================
    // ESTADO
    // ============================================================

    property string selectedWallpaper:
        ""

    property string displayMode:
        "Preencher"

    // ============================================================
    // FILE DIALOG
    // ============================================================

    FileDialog {
        id: fileDialog

        title:
            "Adicionar wallpaper"

        fileMode:
            FileDialog.OpenFile

        nameFilters: [
            "Wallpapers (*.jpg *.jpeg *.png *.webp *.bmp *.gif *.mp4 *.mkv *.webm *.mov *.avi)"
        ]

        onAccepted: {
            if (files.length === 0)
                return

            var source =
                files[0].toString()

            source =
                source.replace(/^file:\/\//, "")

            Quickshell.execDetached([
                "cp",
                "--",
                source,
                manager.wallpaperDirectory + "/"
            ])

            var fileName =
                source.substring(source.lastIndexOf("/") + 1)

            selectedWallpaper =
                manager.wallpaperDirectory + "/" + fileName

            wallpaperModel.reload()

            applyWallpaper(selectedWallpaper)
        }
    }

    // ============================================================
    // FUNÇÃO DE FECHAMENTO
    // ============================================================

    function closeManager() {
        visible = false
    }

    // ============================================================
    // ÁREA PRINCIPAL
    // ============================================================

    Rectangle {
        id: background

        anchors.fill: parent

        radius:
            manager.contentRadius

        color:
            manager.windowColor

        border.width:
            1

        border.color:
            manager.borderColor

        clip:
            true

        // ========================================================
        // CABEÇALHO
        // ========================================================

        Rectangle {
            id: header

            anchors {
                top: parent.top
                left: parent.left
                right: parent.right
            }

            height:
                manager.headerHeight

            color:
                "transparent"

            RowLayout {
                anchors.fill: parent

                anchors.leftMargin:
                    manager.outerMargin

                anchors.rightMargin:
                    manager.outerMargin

                spacing:
                    14

                ColumnLayout {
                    Layout.fillWidth: true

                    spacing:
                        2

                    Text {
                        text:
                            "Wallpaper"

                        color:
                            manager.primaryTextColor

                        font.family:
                            "JetBrains Mono"

                        font.pixelSize:
                            19

                        font.bold:
                            true
                    }

                    Text {
                        text:
                            wallpaperModel.count +
                            " wallpapers disponíveis"

                        color:
                            manager.secondaryTextColor

                        font.family:
                            "JetBrains Mono"

                        font.pixelSize:
                            11
                    }
                }

                ComboBox {
                    id: modeCombo

                    model: [
                        "Preencher",
                        "Ajustar",
                        "Esticar",
                        "Original"
                    ]

                    currentIndex:
                        Math.max(
                            0,
                            model.indexOf(manager.displayMode)
                        )

                    implicitWidth:
                        150

                    implicitHeight:
                        38

                    onActivated: {
                        manager.displayMode =
                            currentText

                        if (manager.selectedWallpaper !== "") {
                            manager.applyWallpaper(
                                manager.selectedWallpaper
                            )
                        }
                    }

                    background: Rectangle {
                        radius:
                            10

                        color:
                            manager.cardColor

                        border.width:
                            1

                        border.color:
                            manager.borderColor
                    }

                    contentItem: Text {
                        text:
                            modeCombo.currentText

                        color:
                            manager.primaryTextColor

                        font.family:
                            "JetBrains Mono"

                        font.pixelSize:
                            12

                        verticalAlignment:
                            Text.AlignVCenter

                        leftPadding:
                            12
                    }
                }

                Button {
                    text:
                        "+ Adicionar"

                    implicitWidth:
                        120

                    implicitHeight:
                        38

                    onClicked:
                        fileDialog.open()

                    background: Rectangle {
                        radius:
                            10

                        color:
                            manager.accentColor
                    }

                    contentItem: Text {
                        text:
                            parent.text

                        color:
                            manager.accentTextColor

                        font.family:
                            "JetBrains Mono"

                        font.pixelSize:
                            11

                        font.bold:
                            true

                        horizontalAlignment:
                            Text.AlignHCenter

                        verticalAlignment:
                            Text.AlignVCenter
                    }
                }
            }
        }

        // ========================================================
        // GRADE
        // ========================================================

        Rectangle {
            id: gridPanel

            anchors {
                top: header.bottom
                left: parent.left
                right: parent.right
                bottom: footer.top
            }

            anchors.margins:
                manager.outerMargin

            radius:
                manager.contentRadius

            color:
                manager.panelColor

            border.width:
                1

            border.color:
                manager.borderColor

            clip:
                true

            GridView {
                id: wallpaperGrid

                anchors.fill:
                    parent

                anchors.margins:
                    14

                cellWidth:
                    manager.cardWidth +
                    manager.gridSpacing

                cellHeight:
                    manager.cardHeight +
                    manager.gridSpacing

                model:
                    wallpaperModel

                clip:
                    true

                delegate: Item {
                    width:
                        manager.cardWidth

                    height:
                        manager.cardHeight

                    property string wallpaperPath:
                        filePath

                    Rectangle {
                        anchors.fill:
                            parent

                        radius:
                            manager.cardRadius

                        color:
                            manager.selectedWallpaper === wallpaperPath
                                ? manager.cardSelectedColor
                                : manager.cardColor

                        border.width:
                            manager.selectedWallpaper === wallpaperPath
                                ? 2
                                : 1

                        border.color:
                            manager.selectedWallpaper === wallpaperPath
                                ? manager.borderSelectedColor
                                : manager.borderColor

                        Behavior on color {
                            ColorAnimation {
                                duration: 120
                            }
                        }

                        Column {
                            anchors.fill:
                                parent

                            anchors.margins:
                                7

                            spacing:
                                6

                            Rectangle {
                                width:
                                    parent.width

                                height:
                                    manager.thumbnailHeight

                                radius:
                                    manager.cardRadius - 3

                                color:
                                    "#151519"

                                clip:
                                    true

                                Image {
                                    anchors.fill:
                                        parent

                                    source:
                                        manager.isStatic(wallpaperPath)
                                            ? "file://" + wallpaperPath
                                            : ""

                                    fillMode:
                                        Image.PreserveAspectCrop

                                    asynchronous:
                                        true

                                    cache:
                                        true

                                    smooth:
                                        true

                                    visible:
                                        manager.isStatic(wallpaperPath)
                                }

                                Rectangle {
                                    anchors.fill:
                                        parent

                                    color:
                                        "#35101014"

                                    visible:
                                        manager.isAnimated(wallpaperPath)
                                }

                                Text {
                                    anchors.centerIn:
                                        parent

                                    text:
                                        manager.isAnimated(wallpaperPath)
                                            ? "▶"
                                            : ""

                                    color:
                                        manager.primaryTextColor

                                    font.pixelSize:
                                        24

                                    visible:
                                        manager.isAnimated(wallpaperPath)
                                }

                                Text {
                                    anchors.left:
                                        parent.left

                                    anchors.bottom:
                                        parent.bottom

                                    anchors.leftMargin:
                                        7

                                    anchors.bottomMargin:
                                        5

                                    text:
                                        manager.isAnimated(wallpaperPath)
                                            ? "ANIMADO"
                                            : "IMAGEM"

                                    color:
                                        manager.primaryTextColor

                                    font.family:
                                        "JetBrains Mono"

                                    font.pixelSize:
                                        8

                                    font.bold:
                                        true
                                }
                            }

                            Text {
                                width:
                                    parent.width

                                text:
                                    fileName

                                color:
                                    manager.primaryTextColor

                                font.family:
                                    "JetBrains Mono"

                                font.pixelSize:
                                    10

                                elide:
                                    Text.ElideMiddle

                                horizontalAlignment:
                                    Text.AlignHCenter
                            }
                        }

                        MouseArea {
                            anchors.fill:
                                parent

                            hoverEnabled:
                                true

                            onEntered: {
                                if (
                                    manager.selectedWallpaper !==
                                    wallpaperPath
                                ) {
                                    parent.color =
                                        manager.cardHoverColor
                                }
                            }

                            onExited: {
                                parent.color =
                                    manager.selectedWallpaper === wallpaperPath
                                        ? manager.cardSelectedColor
                                        : manager.cardColor
                            }

                            onClicked: {
                                manager.applyWallpaper(
                                    wallpaperPath
                                )
                            }
                        }
                    }
                }
            }

            Text {
                anchors.centerIn:
                    parent

                text:
                    "Nenhum wallpaper encontrado"

                color:
                    manager.mutedTextColor

                font.family:
                    "JetBrains Mono"

                font.pixelSize:
                    13

                visible:
                    wallpaperModel.count === 0
            }
        }

        // ========================================================
        // RODAPÉ
        // ========================================================

        Rectangle {
            id: footer

            anchors {
                left: parent.left
                right: parent.right
                bottom: parent.bottom
            }

            height:
                manager.footerHeight

            color:
                "transparent"

            RowLayout {
                anchors.fill: parent

                anchors.leftMargin:
                    manager.outerMargin

                anchors.rightMargin:
                    manager.outerMargin

                Text {
                    Layout.fillWidth:
                        true

                    text:
                        manager.selectedWallpaper === ""
                            ? "Selecione um wallpaper"
                            : manager.selectedWallpaper

                    color:
                        manager.secondaryTextColor

                    font.family:
                        "JetBrains Mono"

                    font.pixelSize:
                        10

                    elide:
                        Text.ElideMiddle
                }

                Button {
                    text:
                        "Fechar"

                    implicitWidth:
                        90

                    implicitHeight:
                        36

                    onClicked:
                        manager.closeManager()

                    background: Rectangle {
                        radius:
                            10

                        color:
                            manager.cardColor

                        border.width:
                            1

                        border.color:
                            manager.borderColor
                    }

                    contentItem: Text {
                        text:
                            parent.text

                        color:
                            manager.primaryTextColor

                        font.family:
                            "JetBrains Mono"

                        font.pixelSize:
                            11

                        horizontalAlignment:
                            Text.AlignHCenter

                        verticalAlignment:
                            Text.AlignVCenter
                    }
                }
            }
        }
    }
}
