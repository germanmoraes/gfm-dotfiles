import Quickshell
import QtQuick
import QtQuick.Controls

Item {
    id: archLauncher

    implicitWidth: 50
    implicitHeight: 32

    // ============================================================
    // TEMA — FONTES
    // ============================================================

    readonly property string textFontFamily:
        "sans-serif"

    readonly property string iconFontFamily:
        "JetBrainsMono Nerd Font"

    // ============================================================
    // TEMA — TAMANHOS DE FONTE
    // ============================================================

    readonly property int launcherIconFontSize:
        19

    readonly property int searchIconFontSize:
        18

    readonly property int searchFontSize:
        16

    readonly property int applicationNameFontSize:
        15

    readonly property int applicationDescriptionFontSize:
        12

    // ============================================================
    // ESTADO
    // ============================================================

    property bool launcherVisible: false

    // ============================================================
    // BOTÃO ARCH
    // ============================================================

    Rectangle {
        id: button

        anchors.fill:
            parent

        radius:
            16

        color:
            mouseArea.containsMouse
            ? "#25232b"
            : "#000000"

        border.width:
            1

        border.color:
            mouseArea.containsMouse
            ? "#3a3542"
            : "#18161c"

        Behavior on color {
            ColorAnimation {
                duration: 120
            }
        }

        Text {
            anchors.centerIn:
                parent

            text:
                ""

            font.family:
                archLauncher.iconFontFamily

            font.pixelSize:
                archLauncher.launcherIconFontSize

            color:
                mouseArea.containsMouse
                ? "#ffffff"
                : "#d8d8dc"
        }

        MouseArea {
            id: mouseArea

            anchors.fill:
                parent

            hoverEnabled:
                true

            onClicked: {
                console.log("ARCH LAUNCHER: CLIQUE RECEBIDO")
                launcher.toggle()
            }
        }
    }





    // ============================================================
    // LANÇADOR
    // ============================================================

    PopupWindow {
        id: launcher

        visible:
            false

        grabFocus:
            true

        anchor.window:
            archLauncher.Window.window

        anchor.rect.x:
            (archLauncher.Window.window.width - width) / 2

        anchor.rect.y:
            48 + 12

        width:
            620

        height:
            620

        color:
            "transparent"

        property string searchText:
            ""

        property int selectedIndex:
            0

        // ========================================================
        // ABRIR / FECHAR
        // ========================================================

        function toggle() {

            visible =
                !visible

            if (visible) {

                searchText =
                    ""

                selectedIndex =
                    0

                Qt.callLater(function() {
                    searchInput.forceActiveFocus()
                })
            }
        }

        // ========================================================
        // NORMALIZAÇÃO
        // ========================================================

        function normalize(text) {

            return String(text || "")
                .toLowerCase()
                .normalize("NFD")
                .replace(
                    /[\u0300-\u036f]/g,
                    ""
                )
        }

        // ========================================================
        // DISTÂNCIA DE LEVENSHTEIN
        // ========================================================

        function levenshtein(a, b) {

            a =
                normalize(a)

            b =
                normalize(b)

            if (a === b)
                return 0

            if (a.length === 0)
                return b.length

            if (b.length === 0)
                return a.length

            var previous = []

            for (
                var i = 0;
                i <= b.length;
                i++
            ) {
                previous[i] =
                    i
            }

            for (
                var row = 1;
                row <= a.length;
                row++
            ) {

                var current =
                    [row]

                for (
                    var column = 1;
                    column <= b.length;
                    column++
                ) {

                    var insertCost =
                        current[column - 1] + 1

                    var deleteCost =
                        previous[column] + 1

                    var replaceCost =
                        previous[column - 1] +
                        (
                            a.charAt(row - 1) ===
                            b.charAt(column - 1)
                            ? 0
                            : 1
                        )

                    current[column] =
                        Math.min(
                            insertCost,
                            deleteCost,
                            replaceCost
                        )
                }

                previous =
                    current
            }

            return previous[b.length]
        }

        // ========================================================
        // PONTUAÇÃO DE PALAVRA
        // ========================================================

        function wordScore(word, target) {

            word =
                normalize(word)

            target =
                normalize(target)

            if (!word || !target)
                return 0

            if (word === target)
                return 1000

            if (word.startsWith(target))
                return 800 -
                    Math.min(
                        word.length,
                        100
                    )

            if (word.includes(target))
                return 600 -
                    Math.min(
                        word.length,
                        100
                    )

            var distance =
                levenshtein(
                    word,
                    target
                )

            var allowed =
                target.length <= 3
                ? 0
                : target.length <= 5
                ? 1
                : target.length <= 8
                ? 2
                : 3

            if (distance <= allowed) {

                return 500 -
                    distance * 80
            }

            return 0
        }

        // ========================================================
        // PONTUAÇÃO DE CAMPO
        // ========================================================

        function fieldScore(text, query) {

            var normalizedText =
                normalize(text)

            var normalizedQuery =
                normalize(query)

            if (
                !normalizedText ||
                !normalizedQuery
            ) {
                return 0
            }

            var score =
                wordScore(
                    normalizedText,
                    normalizedQuery
                )

            var words =
                normalizedText.split(
                    /[\s\-_.:/]+/
                )

            for (
                var i = 0;
                i < words.length;
                i++
            ) {

                score =
                    Math.max(
                        score,
                        wordScore(
                            words[i],
                            normalizedQuery
                        )
                    )
            }

            return score
        }

        // ========================================================
        // PONTUAÇÃO DA APLICAÇÃO
        // ========================================================

        function applicationScore(
            app,
            query
        ) {

            if (!query)
                return 1

            var normalizedQuery =
                normalize(query)

            var tokens =
                normalizedQuery.split(
                    /\s+/
                )

            var total =
                0

            for (
                var i = 0;
                i < tokens.length;
                i++
            ) {

                var token =
                    tokens[i]

                if (!token)
                    continue

                var tokenScore =
                    0

                tokenScore =
                    Math.max(
                        tokenScore,
                        fieldScore(
                            app.name,
                            token
                        ) * 4
                    )

                tokenScore =
                    Math.max(
                        tokenScore,
                        fieldScore(
                            app.genericName,
                            token
                        ) * 2
                    )

                tokenScore =
                    Math.max(
                        tokenScore,
                        fieldScore(
                            app.comment,
                            token
                        )
                    )

                var keywords =
                    app.keywords || []

                for (
                    var k = 0;
                    k < keywords.length;
                    k++
                ) {

                    tokenScore =
                        Math.max(
                            tokenScore,
                            fieldScore(
                                keywords[k],
                                token
                            ) * 2
                        )
                }

                if (tokenScore === 0)
                    return 0

                total +=
                    tokenScore
            }

            return total
        }

        // ========================================================
        // FILTRAR APLICAÇÕES
        // ========================================================

        function filteredApplications() {

            var applications =
                DesktopEntries
                    .applications
                    .values

            var query =
                normalize(
                    searchText
                ).trim()

            var results =
                []

            for (
                var i = 0;
                i < applications.length;
                i++
            ) {

                var app =
                    applications[i]

                if (
                    !app ||
                    app.noDisplay
                ) {
                    continue
                }

                var score =
                    applicationScore(
                        app,
                        query
                    )

                if (score > 0) {

                    results.push({
                        app: app,
                        score: score
                    })
                }
            }

            results.sort(
                function(a, b) {

                    if (
                        b.score !==
                        a.score
                    ) {
                        return (
                            b.score -
                            a.score
                        )
                    }

                    return String(
                        a.app.name
                    ).localeCompare(
                        String(
                            b.app.name
                        )
                    )
                }
            )

            var output =
                []

            for (
                var j = 0;
                j < results.length;
                j++
            ) {

                output.push(
                    results[j].app
                )
            }

            return output
        }

        // ========================================================
        // EXECUTAR APLICAÇÃO
        // ========================================================

        function launch(index) {

            var apps =
                filteredApplications()

            if (
                index < 0 ||
                index >= apps.length
            ) {
                return
            }

            var app =
                apps[index]

            visible =
                false

            app.execute()
        }

        // ========================================================
        // MODELO
        // ========================================================

        ScriptModel {
            id: applicationModel

            values:
                launcher.filteredApplications()
        }

        // ========================================================
        // FUNDO
        // ========================================================

        Rectangle {
            anchors.fill:
                parent

            radius:
                22

            color:
                "#111014"

            border.width:
                1

            border.color:
                "#302b38"

            layer.enabled:
                true
        }

        // ========================================================
        // CONTEÚDO
        // ========================================================

        Column {
            anchors.fill:
                parent

            anchors.margins:
                14

            spacing:
                10

            // ====================================================
            // PESQUISA
            // ====================================================

            Rectangle {
                id: searchBox

                width:
                    parent.width

                height:
                    54

                radius:
                    15

                color:
                    "#1b1920"

                border.width:
                    1

                border.color:
                    searchInput.activeFocus
                    ? "#4d4658"
                    : "#29252f"

                Row {
                    anchors.fill:
                        parent

                    anchors.leftMargin:
                        16

                    anchors.rightMargin:
                        14

                    spacing:
                        12

                    Text {
                        anchors.verticalCenter:
                            parent.verticalCenter

                        text:
                            ""

                        font.family:
                            archLauncher.iconFontFamily

                        font.pixelSize:
                            archLauncher.searchIconFontSize

                        color:
                            "#8b8b92"
                    }

                    TextInput {
                        id: searchInput

                        width:
                            parent.width - 42

                        height:
                            parent.height

                        verticalAlignment:
                            Text.AlignVCenter

                        color:
                            "#eeeeef"

                        selectionColor:
                            "#4d4658"

                        selectedTextColor:
                            "#ffffff"

                        font.family:
                            archLauncher.textFontFamily

                        font.pixelSize:
                            archLauncher.searchFontSize

                        clip:
                            true

                        focus:
                            false

                        text:
                            launcher.searchText

                        onTextChanged: {

                            launcher.searchText =
                                text

                            launcher.selectedIndex =
                                0

                            applicationList.currentIndex =
                                0
                        }

                        onAccepted: {

                            launcher.launch(
                                launcher.selectedIndex
                            )
                        }

                        Keys.onPressed:
                            function(event) {

                            if (
                                event.key ===
                                Qt.Key_Down
                            ) {

                                if (
                                    applicationList.count >
                                    0
                                ) {

                                    launcher.selectedIndex =
                                        Math.min(
                                            launcher.selectedIndex + 1,
                                            applicationList.count - 1
                                        )

                                    applicationList.currentIndex =
                                        launcher.selectedIndex
                                }

                                event.accepted =
                                    true
                            }

                            else if (
                                event.key ===
                                Qt.Key_Up
                            ) {

                                if (
                                    applicationList.count >
                                    0
                                ) {

                                    launcher.selectedIndex =
                                        Math.max(
                                            launcher.selectedIndex - 1,
                                            0
                                        )

                                    applicationList.currentIndex =
                                        launcher.selectedIndex
                                }

                                event.accepted =
                                    true
                            }

                            else if (
                                event.key ===
                                Qt.Key_Escape
                            ) {

                                launcher.visible =
                                    false

                                event.accepted =
                                    true
                            }
                        }
                    }
                }
            }

            // ====================================================
            // LISTA DE APLICAÇÕES
            // ====================================================

            ListView {
                id: applicationList

                width:
                    parent.width

                height:
                    parent.height - 64

                clip:
                    true

                spacing:
                    4

                currentIndex:
                    launcher.selectedIndex

                model:
                    applicationModel

                ScrollBar.vertical:
                    ScrollBar {
                        policy:
                            ScrollBar.AsNeeded
                    }

                delegate:
                    Rectangle {

                        required property var modelData

                        width:
                            applicationList.width - 8

                        height:
                            58

                        radius:
                            13

                        color:
                            ListView.isCurrentItem
                            ? "#25212d"
                            : "transparent"

                        border.width:
                            ListView.isCurrentItem
                            ? 1
                            : 0

                        border.color:
                            "#3b3446"

                        Row {
                            anchors.fill:
                                parent

                            anchors.leftMargin:
                                12

                            anchors.rightMargin:
                                12

                            spacing:
                                14

                            Image {
                                width:
                                    34

                                height:
                                    34

                                anchors.verticalCenter:
                                    parent.verticalCenter

                                source:
                                    Quickshell.iconPath(
                                        modelData.icon,
                                        ""
                                    )

                                fillMode:
                                    Image.PreserveAspectFit

                                smooth:
                                    true
                            }

                            Column {
                                anchors.verticalCenter:
                                    parent.verticalCenter

                                width:
                                    parent.width - 48

                                spacing:
                                    2

                                Text {
                                    width:
                                        parent.width

                                    text:
                                        modelData.name

                                    color:
                                        "#eeeeef"

                                    font.family:
                                        archLauncher.textFontFamily

                                    font.pixelSize:
                                        archLauncher.applicationNameFontSize

                                    font.weight:
                                        Font.Medium

                                    elide:
                                        Text.ElideRight
                                }

                                Text {
                                    width:
                                        parent.width

                                    text:
                                        modelData.genericName ||
                                        modelData.comment ||
                                        ""

                                    color:
                                        "#85838b"

                                    font.family:
                                        archLauncher.textFontFamily

                                    font.pixelSize:
                                        archLauncher.applicationDescriptionFontSize

                                    elide:
                                        Text.ElideRight

                                    visible:
                                        text.length > 0
                                }
                            }
                        }

                        MouseArea {
                            anchors.fill:
                                parent

                            hoverEnabled:
                                true

                            onEntered: {

                                launcher.selectedIndex =
                                    index

                                applicationList.currentIndex =
                                    index
                            }

                            onClicked: {

                                launcher.launch(
                                    index
                                )
                            }
                        }
                    }
            }
        }

        // ========================================================
        // LIMPEZA DO FOCO
        // ========================================================

        onVisibleChanged: {

            if (!visible)
                searchInput.clearFocus()
        }
    }
}
