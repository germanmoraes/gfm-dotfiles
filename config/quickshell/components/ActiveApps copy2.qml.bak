import Quickshell
import Quickshell.Hyprland
import QtQuick

Row {
    id: activeApps

    spacing: 4

    Repeater {
        model: Hyprland.toplevels

        Rectangle {
            required property var modelData

            width: 32
            height: 32

            radius: 16

            color: mouseArea.containsMouse
                ? "#303030"
                : "#000000"

            Behavior on color {
                ColorAnimation {
                    duration: 150
                }
            }

            Image {
                id: appIcon

                anchors.centerIn: parent

                width: 18
                height: 18

                source: {
                    let appId = modelData.wayland
                        ? modelData.wayland.appId || ""
                        : ""

                    if (appId === "dev.zed.Zed") {
                        return Quickshell.iconPath("zed", true)
                    }

                    return Quickshell.iconPath(appId, true)
                }

                fillMode: Image.PreserveAspectFit
                smooth: true
            }

            Text {
                anchors.centerIn: parent

                visible: appIcon.status !== Image.Ready

                text: "?"

                color: "#ff5577"

                font.pixelSize: 11
            }

            Rectangle {
                anchors.horizontalCenter: parent.horizontalCenter

                anchors.bottom: parent.bottom
                anchors.bottomMargin: 4

                width: modelData.activated ? 14 : 0
                height: 2

                radius: 1

                color: "#707070"

                Behavior on width {
                    NumberAnimation {
                        duration: 150
                    }
                }
            }

            MouseArea {
                id: mouseArea

                anchors.fill: parent

                hoverEnabled: true

                onClicked: {
                    if (modelData.wayland) {
                        modelData.wayland.activate()
                    }
                }
            }
        }
    }
}
