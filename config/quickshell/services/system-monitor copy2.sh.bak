#!/bin/bash

INTERVAL=1

declare -a CPU_PREV_TOTAL
declare -a CPU_PREV_IDLE

PREV_RX=0
PREV_TX=0
PREV_NET_TIME=0

GPU_PATH=""

find_gpu()
{
    for card in /sys/class/drm/card*; do
        [ -e "$card/device/driver" ] || continue

        driver="$(readlink -f "$card/device/driver" 2>/dev/null)"

        case "$driver" in
            */amdgpu)
                GPU_PATH="$card/device"
                return
                ;;
        esac
    done

    GPU_PATH=""
}

read_cpu()
{
    local stat
    stat="$(cat /proc/stat 2>/dev/null)"

    awk -v prev_total_file="/tmp/quickshell-cpu-total" \
        -v prev_idle_file="/tmp/quickshell-cpu-idle" '
    /^cpu[0-9]+[[:space:]]/ {
        cpu=$1

        total=$2+$3+$4+$5+$6+$7+$8+$9+$10
        idle=$5+$6

        totals[cpu]=total
        idles[cpu]=idle

        count++
    }

    END {
        printf "CPU|"

        for (i=0; i<count; i++) {
            cpu="cpu" i

            total=totals[cpu]
            idle=idles[cpu]

            prevTotal=0
            prevIdle=0

            if ((getline line < prev_total_file) > 0) {
                split(line, pt, " ")
                prevTotal=pt[i+1]+0
            }
            close(prev_total_file)

            if ((getline line < prev_idle_file) > 0) {
                split(line, pi, " ")
                prevIdle=pi[i+1]+0
            }
            close(prev_idle_file)

            if (prevTotal > 0) {
                dt=total-prevTotal
                di=idle-prevIdle

                if (dt > 0)
                    usage=100*(dt-di)/dt
                else
                    usage=0
            }
            else {
                usage=0
            }

            if (usage < 0) usage=0
            if (usage > 100) usage=100

            printf "%.1f", usage

            if (i < count-1)
                printf ","
        }

        printf "\n"

        printf "%s", ""
        for (i=0; i<count; i++)
            printf "%s ", totals["cpu" i] > prev_total_file
        close(prev_total_file)

        for (i=0; i<count; i++)
            printf "%s ", idles["cpu" i] > prev_idle_file
        close(prev_idle_file)
    }'
}

read_memory()
{
    awk '
    /^MemTotal:/ {
        total=$2
    }

    /^MemAvailable:/ {
        available=$2
    }

    /^SwapTotal:/ {
        swapTotal=$2
    }

    /^SwapFree:/ {
        swapFree=$2
    }

    END {
        used=total-available
        swapUsed=swapTotal-swapFree

        printf "MEM|%d|%d|%d|%d\n",
            used,
            total,
            swapUsed,
            swapTotal
    }
    ' /proc/meminfo
}

read_network()
{
    local rx=0
    local tx=0
    local iface=""

    while read -r interface values; do
        case "$interface" in
            lo:)
                continue
                ;;
        esac

        interface="${interface%:}"

        rx_bytes="$(awk '{print $1}' <<< "$values")"
        tx_bytes="$(awk '{print $9}' <<< "$values")"

        [[ "$rx_bytes" =~ ^[0-9]+$ ]] || continue
        [[ "$tx_bytes" =~ ^[0-9]+$ ]] || continue

        rx=$((rx + rx_bytes))
        tx=$((tx + tx_bytes))

        if [ -z "$iface" ]; then
            iface="$interface"
        fi
    done < <(tail -n +3 /proc/net/dev)

    now="$(date +%s%N)"

    if [ "$PREV_NET_TIME" -gt 0 ]; then
        elapsed_ns=$((now - PREV_NET_TIME))

        if [ "$elapsed_ns" -gt 0 ]; then
            down=$(( (rx - PREV_RX) * 1000000000 / elapsed_ns ))
            up=$(( (tx - PREV_TX) * 1000000000 / elapsed_ns ))
        else
            down=0
            up=0
        fi
    else
        down=0
        up=0
    fi

    [ "$down" -lt 0 ] && down=0
    [ "$up" -lt 0 ] && up=0

    PREV_RX="$rx"
    PREV_TX="$tx"
    PREV_NET_TIME="$now"

    printf 'NET|%s|%s|%s|%s\n' \
        "$down" \
        "$up" \
        "$rx" \
        "$tx"
}

read_gpu()
{
    [ -n "$GPU_PATH" ] || find_gpu

    if [ -z "$GPU_PATH" ]; then
        printf 'GPU|0|0|0|0|0|0|0\n'
        return
    fi

    busy="$(cat "$GPU_PATH/gpu_busy_percent" 2>/dev/null || echo 0)"
    mem_busy="$(cat "$GPU_PATH/mem_busy_percent" 2>/dev/null || echo 0)"

    vram_used="$(cat "$GPU_PATH/mem_info_vram_used" 2>/dev/null || echo 0)"
    vram_total="$(cat "$GPU_PATH/mem_info_vram_total" 2>/dev/null || echo 0)"

    gtt_used="$(cat "$GPU_PATH/mem_info_gtt_used" 2>/dev/null || echo 0)"
    gtt_total="$(cat "$GPU_PATH/mem_info_gtt_total" 2>/dev/null || echo 0)"

    power="$(cat "$GPU_PATH/hwmon/hwmon*/power1_average" 2>/dev/null | head -n1 || echo 0)"

    clock=0

    if [ -f "$GPU_PATH/pp_dpm_sclk" ]; then
        active_clock="$(grep '\*' "$GPU_PATH/pp_dpm_sclk" 2>/dev/null | head -n1)"

        if [ -n "$active_clock" ]; then
            clock="$(sed -n 's/.* \([0-9]\+\)Mhz.*/\1/p' <<< "$active_clock")"
        fi
    fi

    temp=0

    for hwmon in "$GPU_PATH"/hwmon/hwmon*; do
        [ -d "$hwmon" ] || continue

        name="$(cat "$hwmon/name" 2>/dev/null)"

        if [ "$name" = "amdgpu" ]; then
            for sensor in "$hwmon"/temp*_input; do
                [ -f "$sensor" ] || continue

                value="$(cat "$sensor" 2>/dev/null)"

                if [[ "$value" =~ ^[0-9]+$ ]]; then
                    temp=$((value / 1000))
                    break
                fi
            done
        fi
    done

    printf 'GPU|%s|%s|%s|%s|%s|%s|%s|%s\n' \
        "$busy" \
        "$mem_busy" \
        "$vram_used" \
        "$vram_total" \
        "$gtt_used" \
        "$gtt_total" \
        "$clock" \
        "$power"
}

while true; do
    read_cpu
    read_memory
    read_network
    read_gpu

    sleep "$INTERVAL"
done
