import Quickshell
import Quickshell.Io
import QtQuick

Item {
    id: root

    property real cpuUsage: 0
    property real cpuTemperature: 0

    property real memoryUsage: 0

    property real gpuUsage: 0

    property string downloadSpeed: "0 B/s"
    property string uploadSpeed: "0 B/s"

    readonly property string scriptPath:
        Quickshell.env("HOME") +
        "/.config/quickshell/services/system-monitor.sh"

    function formatSpeed(bytesPerSecond) {
        if (bytesPerSecond < 1024)
            return Math.round(bytesPerSecond) + " B/s"

        if (bytesPerSecond < 1024 * 1024)
            return (bytesPerSecond / 1024).toFixed(1) + " KB/s"

        if (bytesPerSecond < 1024 * 1024 * 1024)
            return (bytesPerSecond / (1024 * 1024)).toFixed(1) + " MB/s"

        if (bytesPerSecond < 1024 * 1024 * 1024 * 1024)
            return (bytesPerSecond / (1024 * 1024 * 1024)).toFixed(1) + " GB/s"

        return (bytesPerSecond /
                (1024 * 1024 * 1024 * 1024)).toFixed(1) + " TB/s"
    }

    function parseLine(line) {
        if (!line)
            return

        var parts = line.split("|")
        var type = parts[0]

        if (type === "CPU" && parts.length >= 3) {
            var cpu = parseFloat(parts[1])
            var temperature = parseFloat(parts[2])

            if (!isNaN(cpu))
                root.cpuUsage = cpu

            if (!isNaN(temperature))
                root.cpuTemperature = temperature

            return
        }

        if (type === "MEM" && parts.length >= 2) {
            var memory = parseFloat(parts[1])

            if (!isNaN(memory))
                root.memoryUsage = memory

            return
        }

        if (type === "GPU" && parts.length >= 2) {
            var gpu = parseFloat(parts[1])

            if (!isNaN(gpu))
                root.gpuUsage = gpu

            return
        }

        if (type === "NET" && parts.length >= 3) {
            var down = parseFloat(parts[1])
            var up = parseFloat(parts[2])

            if (!isNaN(down))
                root.downloadSpeed = formatSpeed(down)

            if (!isNaN(up))
                root.uploadSpeed = formatSpeed(up)

            return
        }
    }

    Process {
        id: monitorProcess

        command: [
            "bash",
            root.scriptPath
        ]

        running: true

        stdout: SplitParser {
            splitMarker: "\n"

            onRead: function(data) {
                root.parseLine(data.trim())
            }
        }
    }

    Component.onDestruction: {
        if (monitorProcess.running)
            monitorProcess.running = false
    }
}
